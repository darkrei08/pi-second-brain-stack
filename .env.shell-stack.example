# Clone these published repositories beside this checkout, then pin the revisions in docs/shell-stack.md.
BACKEND_REPO=../second-brain-backend
SHELL_REPO=../second-brain-shell
POSTGRES_DB=rag
POSTGRES_USER=rag
POSTGRES_PASSWORD=replace-with-a-local-password
GATEWAY_TOKEN=replace-with-at-least-32-random-characters
GATEWAY_PRINCIPALS=[{"token":"replace-with-the-same-gateway-token","owner_id":"operator-owner"}]
WEBUI_SECRET_KEY=replace-with-a-random-secret
ANSWER_BASE_URL=http://127.0.0.1:8317/v1
ANSWER_MODEL=deepseek-v4.1-flash
ANSWER_API_KEY=read-from-your-local-proxy-config
ANSWER_ALLOWED_HOSTS=127.0.0.1
GATEWAY_URL=http://127.0.0.1:18080
