{
  "name": "second-brain-stack-segmentation",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "src/",
    "README.md"
  ],
  "exports": {
    ".": "./src/index.js"
  },
