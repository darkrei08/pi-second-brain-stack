# Default compose environment: the shared variables every compose project reads.
# Secrets are not here. scripts/compose-up.sh generates them into
# .secrets/compose.env on first start; the defaults below are copied from this
# file into the docker compose invocation, never the other way round.
POSTGRES_DB=second_brain
POSTGRES_USER=second_brain
# PostgreSQL password secret. Generated on first start; export it to override.
POSTGRES_PASSWORD=
# Loopback host port published for PostgreSQL.
POSTGRES_HOST_PORT=55432

# Gateway bearer-token secret. Generated on first start; export it to override.
GATEWAY_TOKEN=
# Opaque owner identifier used for server-derived ownership.
GATEWAY_OWNER_ID=local-owner
# Loopback host port published for the gateway.
GATEWAY_HOST_PORT=8080
# Optional per-shell-user to owner mapping as a JSON object.
GATEWAY_SHELL_USERS={}
# Gateway request quota per minute.
GATEWAY_REQUESTS_PER_MINUTE=60
# Gateway maximum concurrent requests.
GATEWAY_MAX_CONCURRENT_REQUESTS=8
# Gateway URL stored in the Open WebUI Function valves.
GATEWAY_URL=http://gateway:8080

# Optional OpenAI-compatible answer endpoint; leave commented to disable model calls.
# ANSWER_BASE_URL=
# Optional answer model name used with ANSWER_BASE_URL.
# ANSWER_MODEL=
# Optional answer-provider API key secret; leave blank for local providers.
# ANSWER_API_KEY=
# Optional OpenAI-compatible embedding endpoint; leave commented to disable embeddings.
# EMBEDDING_BASE_URL=
# Optional embedding-provider API key secret; leave blank for local providers.
# EMBEDDING_API_KEY=

# Persistent Open WebUI session/authentication secret. Generated on first start.
WEBUI_SECRET_KEY=
# Loopback host port published for Open WebUI.
WEBUI_HOST_PORT=3300

# Host directory containing fullchain.pem and privkey.pem for the TLS example override.
# GATEWAY_TLS_DIR=

# Parser engine. An empty allowlist means loopback only, which is the default topology.
PARSER_ENGINE_BASE_URL=http://127.0.0.1:5001
PARSER_ENGINE_ALLOWED_HOSTS=
PARSER_ENGINE_TIMEOUT_MS=60000
